# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Vision Model Configuration (GPT-4o or LLaVA only)
# VISION_MODEL_PROVIDER can be: openai (for GPT-4o) or llava (for LLaVA)
VISION_MODEL_PROVIDER=openai
VISION_MODEL=gpt-4o
# Optional custom API base (e.g., http://localhost:11434/v1 for local Ollama/LLaVA)
# VISION_API_BASE=
# VISION_API_KEY=

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Langfuse Observability & Tracing Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# General Application Settings
ENV=development
LOG_LEVEL=INFO
OMNIBRAIN_ENV=mock

